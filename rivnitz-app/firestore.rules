rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ──────────────────────────────────────────
    function isLoggedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return isLoggedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ─── Users ─────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isLoggedIn() && (isOwner(userId) || isAdmin());
      allow create: if isLoggedIn() && isOwner(userId);
      allow update: if isLoggedIn() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // ─── Videos ────────────────────────────────────────────────────
    match /videos/{videoId} {
      allow read:   if isLoggedIn();
      allow write:  if isAdmin();
    }

    // ─── Community Posts ───────────────────────────────────────────
    match /community_posts/{postId} {
      allow read:   if isLoggedIn();
      allow create: if isLoggedIn();
      allow update: if isLoggedIn() && (
        request.auth.uid == resource.data.authorId || isAdmin()
      );
      allow delete: if isAdmin() ||
        (isLoggedIn() && request.auth.uid == resource.data.authorId);
    }

    // ─── AI Sessions ───────────────────────────────────────────────
    match /ai_sessions/{sessionId} {
      allow read:   if isLoggedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isLoggedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── AI Escalations ────────────────────────────────────────────
    match /ai_escalations/{escalationId} {
      allow read:   if isAdmin() || (
        isLoggedIn() && resource.data.userId == request.auth.uid
      );
      allow create: if isLoggedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Prayer Requests ───────────────────────────────────────────
    match /prayer_requests/{requestId} {
      allow read:   if isAdmin() || (
        isLoggedIn() && resource.data.userId == request.auth.uid
      );
      allow create: if isLoggedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Live Sessions ─────────────────────────────────────────────
    match /live_sessions/{sessionId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();

      // Waiting room sub-collection
      match /waitingRoom/{entryId} {
        allow read:   if isLoggedIn();
        allow create: if isLoggedIn();
        allow update: if isLoggedIn() && (
          resource.data.userId == request.auth.uid || isAdmin()
        );
        allow delete: if isAdmin();
      }
    }

    // ─── Daily Tasks ───────────────────────────────────────────────
    match /daily_tasks/{docId} {
      allow read:   if isLoggedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isLoggedIn();
      allow update: if isLoggedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ─── AI Knowledge Base ────────────────────────────────────────
    // Active entries: readable by all logged-in users (AI needs them)
    // Write: admin only
    match /ai_knowledge/{entryId} {
      allow read:  if isLoggedIn();
      allow write: if isAdmin();
    }

    // ─── AI Config (system prompt + behavior) ──────────────────
    match /ai_config/{docId} {
      allow read:  if isLoggedIn();
      allow write: if isAdmin();
    }

    // ─── Donations ─────────────────────────────────────────────────
    match /donations/{donationId} {
      allow read:   if isAdmin() || (
        isLoggedIn() && resource.data.userId == request.auth.uid
      );
      allow create: if isLoggedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Notifications ─────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read:   if isLoggedIn();
      allow write:  if isAdmin();
    }
  }
}
